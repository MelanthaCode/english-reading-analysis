{
  "name": "dsh-skill-english-reading",
  "version": "1.0.8",
  "type": "module",
  "description": "English reading analysis as a DSH plugin: turns English passages and exam papers into Chinese analysis with a print-ready A4 PDF. Registers the skill into the Harness skill catalog on install.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "skills"
  ],
  "scripts": {
    "sync": "node sync-skill.mjs",
    "prepack": "node sync-skill.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "skill",
    "english",
    "translation",
    "reading-comprehension",
    "exam-paper",
    "education",
    "pdf"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "homepage": "https://github.com/MelanthaCode/english-reading-analysis/tree/main/dsh-plugin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MelanthaCode/english-reading-analysis.git",
    "directory": "dsh-plugin"
  },
  "bugs": {
    "url": "https://github.com/MelanthaCode/english-reading-analysis/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "author": "Melantha"
}
